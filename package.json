{
  "name": "ghvswebtpc-desktop",
  "version": "1.1.9",
  "author": {
    "name": "T-PageCode",
    "email": "cdt20260@outlook.com"
  },
  "description": "Ghvswebtpc网页版系统桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis zip"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "io.github.t-pagecode.ghvswebtpc-desktop",
    "productName": "Ghvswebtpc Desktop",
    "artifactName": "Ghvswebtpc-Desktop-Setup-${version}.${ext}",
    "icon": "icon.ico",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "uninstallDisplayName": "Ghvswebtpc Desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "T-PageCode",
        "repo": "Ghvswebtpc-Desktop"
      }
    ]
  }
}